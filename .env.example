# Copy to .env using scripts/setup-local.ps1; never commit real values.
DATABASE_PASSWORD=replace-with-generated-value
REDIS_PASSWORD=replace-with-generated-value
JWT_SECRET_BASE64=replace-with-at-least-32-random-bytes-base64
ANALYSIS_INTERNAL_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Provider analysis stays off until written source terms are reviewed. Use the exact source ID.
ANALYSIS_PROVIDER_SOURCE_ID=
ANALYSIS_PROVIDER_STORAGE_RIGHTS_CONFIRMED=false
ANALYSIS_PROVIDER_CACHE_RIGHTS_CONFIRMED=false
ANALYSIS_PROVIDER_DISPLAY_RIGHTS_CONFIRMED=false
ANALYSIS_PROVIDER_DERIVED_RIGHTS_CONFIRMED=false
# Directional analysis remains suppressed until the source series is corporate-action safe.
ANALYSIS_CORPORATE_ACTIONS_VERIFIED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://replace-with-extension-id,http://tauri.localhost,http://127.0.0.1:1420
APP_SINGLE_USER_MODE=true
# Price alerts stay paused until written provider rights are verified and all four gates are configured.
ALERTS_MARKET_DATA_ENABLED=false
ALERTS_SOURCE_ID=
ALERTS_STORAGE_RIGHTS_CONFIRMED=false
ALERTS_DERIVED_RIGHTS_CONFIRMED=false
ALERTS_DISPLAY_RIGHTS_CONFIRMED=false
